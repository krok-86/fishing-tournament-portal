# Корневой шаблон окружения. Секреты сюда не писать и в git не коммитить:
# рабочие значения задаются в панелях Vercel и Render (см. комментарии ниже).

# --- Фронтенд (Vite, сборка на Vercel) ---
# Куда писать: Vercel → Project → Settings → Environment Variables.
# Имя: VITE_API_URL
# Значение: публичный URL бэкенда Express на Render, без завершающего слэша.
# Пример: https://fishing-tournament-portal.onrender.com
# Vite подставляет переменные VITE_* во время сборки — сохраните её до Build.
VITE_API_URL=

# --- Бэкенд (Express, процесс на Render) ---
# Куда писать: Render → ваш Web Service → Environment → Environment Variables.
# Имя: DATABASE_URL
# Значение: URI PostgreSQL из Supabase
# (Project Settings → Database → Connection string → URI).
# Берите строку базы postgres как есть, вместе с sslmode, если он есть в URI.
# Пример: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=
